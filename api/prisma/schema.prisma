generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  WOMAN
  MAN
  NONBINARY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  birthDate    DateTime @db.Date
  gender       Gender
  seeking      Gender[]
  city         String
  createdAt    DateTime @default(now())

  belief         Belief?
  answers        Answer[]
  questionSets   DailyQuestionSet[]
  matchesAsA     Match[]            @relation("MatchUserA")
  matchesAsB     Match[]            @relation("MatchUserB")
  matchDecisions MatchDecision[]
  messages       Message[]
  chatReads      ChatRead[]
}

model Question {
  id        String  @id
  dimension Int
  text      String
  noise     Float
  reverse   Boolean

  answers Answer[]
}

model Answer {
  userId     String   @db.Uuid
  questionId String
  self       Int      @db.SmallInt
  partner    Int      @db.SmallInt
  importance Int      @db.SmallInt
  answeredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([userId, questionId])
}

model Belief {
  userId      String   @id @db.Uuid
  muSelf      Float[]
  varSelf     Float[]
  muPref      Float[]
  varPref     Float[]
  logWSum     Float[]
  logWCount   Float[]
  answerCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyQuestionSet {
  userId      String   @db.Uuid
  day         DateTime @db.Date
  questionIds String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Match {
  id         String   @id @default(uuid()) @db.Uuid
  day        DateTime @db.Date
  userAId    String   @db.Uuid
  userBId    String   @db.Uuid
  score      Float
  confidence Float
  aligned    String[]
  friction   String
  createdAt  DateTime @default(now())

  userA     User            @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User            @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  decisions MatchDecision[]
  messages  Message[]
  reads     ChatRead[]

  @@unique([userAId, userBId])
  @@index([day, userAId])
  @@index([day, userBId])
}

model MatchDecision {
  matchId   String   @db.Uuid
  userId    String   @db.Uuid
  liked     Boolean
  decidedAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model ChatRead {
  matchId String   @db.Uuid
  userId  String   @db.Uuid
  readAt  DateTime

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}
