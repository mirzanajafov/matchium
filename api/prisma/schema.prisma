generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  WOMAN
  MAN
  NONBINARY
}

enum Role {
  USER
  ADMIN
}

enum ReportOutcome {
  DISMISSED
  BANNED
}

enum ReportReason {
  SPAM
  HARASSMENT
  FAKE_PROFILE
  UNDERAGE
  OTHER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  displayName     String
  birthDate       DateTime  @db.Date
  gender          Gender
  seeking         Gender[]
  city            String
  role            Role      @default(USER)
  emailDigest     Boolean   @default(true)
  emailVerifiedAt DateTime?
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())

  belief         Belief?
  answers        Answer[]
  questionSets   DailyQuestionSet[]
  matchesAsA     Match[]            @relation("MatchUserA")
  matchesAsB     Match[]            @relation("MatchUserB")
  matchDecisions MatchDecision[]
  messages       Message[]
  chatReads      ChatRead[]
  pushes         PushSubscription[]
  reportsMade    Report[]           @relation("ReportsMade")
  reportsAgainst Report[]           @relation("ReportsAgainst")
  sessions       Session[]
}

model Question {
  id        String  @id
  dimension Int
  text      String
  noise     Float
  reverse   Boolean

  answers Answer[]
}

model Answer {
  userId     String   @db.Uuid
  questionId String
  self       Int      @db.SmallInt
  partner    Int      @db.SmallInt
  importance Int      @db.SmallInt
  answeredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([userId, questionId])
}

model Belief {
  userId      String   @id @db.Uuid
  muSelf      Float[]
  varSelf     Float[]
  muPref      Float[]
  varPref     Float[]
  logWSum     Float[]
  logWCount   Float[]
  muGap       Float[]  @default([])
  varGap      Float[]  @default([])
  muBar       Float?
  varBar      Float?
  answerCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyQuestionSet {
  userId      String   @db.Uuid
  day         DateTime @db.Date
  questionIds String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Match {
  id         String    @id @default(uuid()) @db.Uuid
  day        DateTime  @db.Date
  userAId    String    @db.Uuid
  userBId    String    @db.Uuid
  score      Float
  confidence Float
  aligned    String[]
  friction   String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  closedAt   DateTime?
  closedById String?   @db.Uuid

  userA     User            @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User            @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  decisions MatchDecision[]
  messages  Message[]
  reads     ChatRead[]
  reports   Report[]

  @@unique([userAId, userBId])
  @@index([day, userAId])
  @@index([day, userBId])
}

model MatchDecision {
  matchId   String    @db.Uuid
  userId    String    @db.Uuid
  liked     Boolean
  decidedAt DateTime  @default(now())
  learnedAt DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model ChatRead {
  matchId String   @db.Uuid
  userId  String   @db.Uuid
  readAt  DateTime

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String         @id @default(uuid()) @db.Uuid
  matchId    String         @db.Uuid
  reporterId String         @db.Uuid
  reportedId String         @db.Uuid
  reason     ReportReason
  note       String?
  createdAt  DateTime       @default(now())
  reviewedAt DateTime?
  reviewedBy String?        @db.Uuid
  outcome    ReportOutcome?

  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporter User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User  @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)

  @@unique([matchId, reporterId])
  @@index([reportedId])
  @@index([reviewedAt])
}

model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
