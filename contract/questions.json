  "questions": [
    {
      "id": "social_energy.1",
      "dimension": 0,
      "text": "A big party after a long week sounds energizing, not draining.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "social_energy.2",
      "dimension": 0,
      "text": "I'd rather meet new people than spend the evening with close friends.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "social_energy.3",
      "dimension": 0,
      "text": "I often start conversations with strangers.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "social_energy.4",
      "dimension": 0,
      "text": "My ideal weekend has plans with other people on both days.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "social_energy.5",
      "dimension": 0,
      "text": "I recharge by being alone, not by being around people.",
      "noise": 0.4,
      "reverse": true
    },
    {
      "id": "social_energy.6",
      "dimension": 0,
      "text": "I enjoy being the center of attention in a group.",
      "noise": 0.9,
      "reverse": false
    },
    {
      "id": "social_energy.7",
      "dimension": 0,
      "text": "I'd rather go to a crowded concert than a quiet dinner for two.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "social_energy.8",
      "dimension": 0,
      "text": "I know most of my neighbors by name.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "social_energy.9",
      "dimension": 0,
      "text": "After a day full of people I need a quiet evening to myself.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "social_energy.10",
      "dimension": 0,
      "text": "I'm usually the one who suggests getting the group together.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "social_energy.11",
      "dimension": 0,
      "text": "Small talk with people I've just met comes easily to me.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "social_energy.12",
      "dimension": 0,
      "text": "I'd skip a party if I didn't know anyone there.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "adventure.1",
      "dimension": 1,
      "text": "I'd pick a trip to a country I know nothing about over a favorite familiar place.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "adventure.2",
      "dimension": 1,
      "text": "I like trying food I can't pronounce.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "adventure.3",
      "dimension": 1,
      "text": "A last-minute flight somewhere new sounds exciting, not stressful.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "adventure.4",
      "dimension": 1,
      "text": "I'd try skydiving at least once.",
      "noise": 0.9,
      "reverse": false
    },
    {
      "id": "adventure.5",
      "dimension": 1,
      "text": "Routine comforts me more than it bores me.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "adventure.6",
      "dimension": 1,
      "text": "I change hobbies often to try new things.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "adventure.7",
      "dimension": 1,
      "text": "I'd live abroad for a year just to see what it's like.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "adventure.8",
      "dimension": 1,
      "text": "Getting lost in a new city is part of the fun.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "adventure.9",
      "dimension": 1,
      "text": "I'd rather go back to a place I loved than risk a new one.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "adventure.10",
      "dimension": 1,
      "text": "I've done something this year I'd never done before.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "adventure.11",
      "dimension": 1,
      "text": "I'd choose a road trip with no fixed route over a planned tour.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "adventure.12",
      "dimension": 1,
      "text": "Extreme sports are not for me.",
      "noise": 0.7,
      "reverse": true
    },
    {
      "id": "ambition.1",
      "dimension": 2,
      "text": "I'd take a demanding job over a relaxed one if it meant faster growth.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "ambition.2",
      "dimension": 2,
      "text": "I often think about where my career will be in ten years.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "ambition.3",
      "dimension": 2,
      "text": "Working evenings on something I care about feels normal to me.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "ambition.4",
      "dimension": 2,
      "text": "Success at work is a big part of who I am.",
      "noise": 0.4,
      "reverse": false
    },
    {
      "id": "ambition.5",
      "dimension": 2,
      "text": "I'd move to another city for the right career opportunity.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "ambition.6",
      "dimension": 2,
      "text": "I'm happy with a stable job that just pays the bills.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "ambition.7",
      "dimension": 2,
      "text": "I set goals for myself every year and track them.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "ambition.8",
      "dimension": 2,
      "text": "I'd start my own business if I had the chance.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "ambition.9",
      "dimension": 2,
      "text": "Earning a lot of money matters to me.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "ambition.10",
      "dimension": 2,
      "text": "I'd turn down a promotion if it meant less free time.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "ambition.11",
      "dimension": 2,
      "text": "I spend free time learning skills that help my career.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "ambition.12",
      "dimension": 2,
      "text": "I measure a good year mostly by what I achieved at work.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "family.1",
      "dimension": 3,
      "text": "I want to have children someday.",
      "noise": 0.4,
      "reverse": false
    },
    {
      "id": "family.2",
      "dimension": 3,
      "text": "I'd like to live close to my parents.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "family.3",
      "dimension": 3,
      "text": "Big family gatherings are something I look forward to.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "family.4",
      "dimension": 3,
      "text": "Starting a family is one of my top life goals.",
      "noise": 0.4,
      "reverse": false
    },
    {
      "id": "family.5",
      "dimension": 3,
      "text": "I'd be happy with a life without kids.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "family.6",
      "dimension": 3,
      "text": "Family opinion matters when I make big decisions.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "family.7",
      "dimension": 3,
      "text": "I call my parents or siblings several times a week.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "family.8",
      "dimension": 3,
      "text": "I'd want more than two children.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "family.9",
      "dimension": 3,
      "text": "I picture my future home with room for visiting relatives.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "family.10",
      "dimension": 3,
      "text": "I'd move far from my family if life took me there.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "family.11",
      "dimension": 3,
      "text": "Holidays are for family first, friends second.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "family.12",
      "dimension": 3,
      "text": "Having kids isn't something I think about much.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "tidiness.1",
      "dimension": 4,
      "text": "A messy room makes it hard for me to relax.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "tidiness.2",
      "dimension": 4,
      "text": "Dishes should be washed the same day.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "tidiness.3",
      "dimension": 4,
      "text": "I make my bed every morning.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "tidiness.4",
      "dimension": 4,
      "text": "I notice when things at home are out of place.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "tidiness.5",
      "dimension": 4,
      "text": "A little chaos at home doesn't bother me.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "tidiness.6",
      "dimension": 4,
      "text": "I clean even when nobody is coming over.",
      "noise": 0.9,
      "reverse": false
    },
    {
      "id": "tidiness.7",
      "dimension": 4,
      "text": "Everything in my home has a place it goes back to.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "tidiness.8",
      "dimension": 4,
      "text": "Clothes on a chair are fine until the weekend.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "tidiness.9",
      "dimension": 4,
      "text": "I tidy up before I go to bed.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "tidiness.10",
      "dimension": 4,
      "text": "A clean kitchen is a must before I start cooking.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "tidiness.11",
      "dimension": 4,
      "text": "I'd rather pay for a cleaner than argue about chores.",
      "noise": 0.9,
      "reverse": false
    },
    {
      "id": "tidiness.12",
      "dimension": 4,
      "text": "I don't really notice clutter.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "planning.1",
      "dimension": 5,
      "text": "I like having my week planned in advance.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "planning.2",
      "dimension": 5,
      "text": "I book vacations months ahead.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "planning.3",
      "dimension": 5,
      "text": "Spontaneous plans on a free evening annoy me more than they excite me.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "planning.4",
      "dimension": 5,
      "text": "I keep a to-do list or calendar for my personal life.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "planning.5",
      "dimension": 5,
      "text": "I'm usually on time or early.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "planning.6",
      "dimension": 5,
      "text": "I prefer to decide things in the moment.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "planning.7",
      "dimension": 5,
      "text": "I know what I'm doing next weekend already.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "planning.8",
      "dimension": 5,
      "text": "I save money with a plan, not with whatever is left.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "planning.9",
      "dimension": 5,
      "text": "I pack for a trip the day before, not the hour before.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "planning.10",
      "dimension": 5,
      "text": "I like to leave weekends open and see what happens.",
      "noise": 0.5,
      "reverse": true
    },
    {
      "id": "planning.11",
      "dimension": 5,
      "text": "When I travel I have a rough plan for every day.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "planning.12",
      "dimension": 5,
      "text": "Changes to plans at the last minute stress me out.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "tradition.1",
      "dimension": 6,
      "text": "Traditional roles in a relationship make sense to me.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "tradition.2",
      "dimension": 6,
      "text": "Religious or cultural traditions are important in my daily life.",
      "noise": 0.4,
      "reverse": false
    },
    {
      "id": "tradition.3",
      "dimension": 6,
      "text": "Marriage should come before living together.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "tradition.4",
      "dimension": 6,
      "text": "I celebrate holidays the way my family always has.",
      "noise": 0.7,
      "reverse": false
    },
    {
      "id": "tradition.5",
      "dimension": 6,
      "text": "Couples should follow their own rules, not society's.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "tradition.6",
      "dimension": 6,
      "text": "I'd want my partner to share my cultural background.",
      "noise": 0.8,
      "reverse": false
    },
    {
      "id": "tradition.7",
      "dimension": 6,
      "text": "Religion will play a role in how I raise my children.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "tradition.8",
      "dimension": 6,
      "text": "I'd want a traditional wedding.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "tradition.9",
      "dimension": 6,
      "text": "My parents' approval of my partner matters to me.",
      "noise": 0.6,
      "reverse": false
    },
    {
      "id": "tradition.10",
      "dimension": 6,
      "text": "Old customs should change when they no longer fit.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "tradition.11",
      "dimension": 6,
      "text": "I follow the rituals and fasts of my faith or culture.",
      "noise": 0.5,
      "reverse": false
    },
    {
      "id": "tradition.12",
      "dimension": 6,
      "text": "I'd be fine with a partner from a very different background.",
      "noise": 0.6,
      "reverse": true
    },
    {
      "id": "activity.1",
      "dimension": 7,
      "text": "I work out at least three times a week.",
      "noise": 0.4,
      "reverse": false
    },
    {
      "id": "activity.2",
      "dimension": 7,
      "text": "A hiking day beats a movie marathon.",
